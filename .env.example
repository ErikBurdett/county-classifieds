DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-development-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgresql://marketplace:marketplace@127.0.0.1:5432/marketplace
DATABASE_SSL_REQUIRE=false
DJANGO_LOG_LEVEL=INFO
REPORT_RATE_KEY_SECRET=local-development-report-rate-key

# Production values belong in secret/configuration management, never a committed .env file.
AWS_REGION=
AWS_STORAGE_BUCKET_NAME=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SES_FROM_EMAIL=
