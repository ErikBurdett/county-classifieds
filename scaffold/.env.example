# Local development
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-development-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgresql://marketplace:marketplace@127.0.0.1:5432/marketplace
DATABASE_SSL_REQUIRE=false
DJANGO_LOG_LEVEL=INFO

# Production contract. Supply these through AWS Secrets Manager/task configuration;
# do not place real production values in a checked-in .env file.
AWS_REGION=
AWS_STORAGE_BUCKET_NAME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SES_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
